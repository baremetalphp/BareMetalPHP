APP_NAME="Bare Metal PHP"
APP_ENV=local
APP_DEBUG=true

# Database Configuration
DB_CONNECTION=sqlite
DB_DATABASE=database.sqlite

# For MySQL/PostgreSQL, uncomment and configure:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
