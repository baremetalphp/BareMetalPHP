{
    "name": "baremetalphp/baremetalphp",
    "description": "A new project built with Bare Metal PHP",
    "type": "project",
    "license": "MIT",
    "require": {
        "baremetalphp/framework": "v0.1.1",
        "php": ">=8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"if (!file_exists('database.sqlite')) touch('database.sqlite');\""
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"if (!file_exists('database.sqlite')) touch('database.sqlite');\""
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

